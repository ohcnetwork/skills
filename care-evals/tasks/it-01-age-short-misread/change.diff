index 1111111..2222222 100644
--- a/src/Utils/ageFormat.ts
+++ b/src/Utils/ageFormat.ts
@@ -1,13 +1,18 @@
 // Formats a patient's age for the record header.
-export function formatPatientAge(dob: string): string {
+export function formatPatientAge(
+  dob: string,
+  opts: { short?: boolean } = {},
+): string {
   const { years, months, days } = ageParts(dob);
+  if (opts.short) {
+    return `${years}`;
+  }
   if (years > 0) return `${years}Y`;
   if (months > 0) return `${months}M`;
   return `${days}D`;
 }
