# care-loopd secrets — copy to /var/lib/care-loopd/.env, chown care-loopd, chmod 600.
#
# NOT a Nix file, and deliberately not written from a Nix expression: everything in /nix/store is
# world-readable, so a token embedded in configuration.nix is a token published to every user on the
# box. Place this by hand, or generate it with agenix / sops-nix. The module asserts against a store
# path for `environmentFile` for exactly this reason.
#
# Children inherit the whole environment, which is the point: nothing per-user is stored anywhere,
# and one bot identity owns every push ([[PLAN-loop-service]] §9).

# The bot's GitHub token. Needs repo scope on the target repo: the loop pushes branches, opens and
# updates PRs, and reads CI annotations.
GITHUB_TOKEN=

# The opencode provider key. Which variable this is depends on the provider `models.json` selects —
# it is the Copilot/Anthropic key that opencode itself would read.
# ANTHROPIC_API_KEY=

# Jira, for the pre-Step-1 ticket enrichment. Optional: the loop proceeds on the raw kickoff task and
# logs the miss when a fetch fails, so leaving these unset degrades rather than breaks.
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# The bot's git identity, used for commits the loop makes.
GIT_AUTHOR_NAME=care-loop
GIT_AUTHOR_EMAIL=care-loop@ohc.network
GIT_COMMITTER_NAME=care-loop
GIT_COMMITTER_EMAIL=care-loop@ohc.network
