{# ============================================================
   IP ADMISSION TICKET — Account Context (account_base)

   Demonstrates:
   - Account context accessing primary_encounter fields (bound once as `enc`), with a
     graceful fallback when the account has none (common in real data)
   - First-or-dash one-liners: map(attribute=…) | first | default("-")
   - Extensions deep access resolved once with .get(...) or {}
   - Identifier two-column layout with rejectattr + batch(2)
   - encounter_tags + instance_tags merged into one comma list
   - charge_items.filter(title=…, limit=1) with for/else for the "not found" case
   - current_user global and current_datetime() (already IST, takes no args)
   ============================================================ #}

{% set report_title = "IP Admission Ticket" %}
{# Logo must be a data: URI or an https URL on REPORT_ALLOWED_RESOURCE_ORIGINS; anything else is stripped #}
{% set logo_img = "" %}
{% set charge_item_title = "Ipd Admission Charge" %}

{% set patient = account.patient %}
{% set enc = account.primary_encounter %}
{# created_date is "" only when the account has no primary encounter; `if enc` would always be true,
   and any other enc.* access raises when it is missing — so every enc use below is behind has_enc #}
{% set has_enc = enc.created_date %}
{% set attender = ((enc.extensions.get('encounter_attender') or {}).get('attender') or {}) if has_enc else {} %}
{% set identifiers = patient.instance_identifiers | rejectattr('config.display', 'equalto', 'Patient Name') | list %}
{% set tags = ((enc.encounter_tags | map(attribute='display') | list) if has_enc else []) + (patient.instance_tags | map(attribute='display') | list) %}

{% macro cell(label, value, full=false) %}
<td{% if full %} colspan="2"{% endif %}><span class="form-label">{{ label }} :</span> <span class="form-value">{{ value or "-" }}</span></td>
{% endmacro %}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <style>
        @page { size: A4; margin: 150px 40px 80px 40px; }
        body { font-family: "Times New Roman", Times, serif; margin: 0; font-size: 14px; }
        h2 { color: #2E8B57; text-align: center; padding-bottom: 4px; }
        .header { position: fixed; top: -150px; left: 0; right: 0; height: 120px; padding: 10px; }
        .logo { height: 100px; width: auto; }

        .form { width: 100%; border: 1px solid #ccc; border-collapse: collapse; margin-top: 10px; }
        .form td { width: 50%; padding: 6px 10px; font-size: 11px; border: none; border-bottom: 1px solid #e5e5e5; vertical-align: top; }
        .form-label { color: #555; white-space: nowrap; }
        .form-value { font-weight: bold; color: #000; }
        .badge-paid { margin-left: 6px; background-color: #2E8B57; color: white; font-size: 9px; font-weight: bold; padding: 1px 6px; border-radius: 3px; }
        .prepared-by { text-align: center; font-size: 11px; margin-top: 15px; color: #555; }
        .note-text { font-style: italic; font-size: 8px; margin-top: 12px; }
        .footer { margin-top: 8px; border-top: 1px solid #333; font-size: 8px; color: #666; text-align: center; }
    </style>
</head>
<body>
    <div class="header">
        {% if logo_img %}<img class="logo" alt="Logo" src="{{ logo_img }}">{% endif %}
    </div>

    <h2>{{ report_title }}</h2>

    <table class="form">
        {% if has_enc %}
        <tr>
            {{ cell("Department", enc.organizations | map(attribute="organization") | first | default("")) }}
            {{ cell("IP Number", enc.external_identifier) }}
        </tr>
        <tr>
            {{ cell("Encounter Class", enc.encounter_class) }}
            {{ cell("Admitting Doctor", enc.care_team | map(attribute="user.full_name") | first | default("")) }}
        </tr>
        <tr>
            {{ cell("Admission Date", enc.start_time | datetime) }}
            {{ cell("Status", enc.status) }}
        </tr>
        {% else %}
        <tr>{{ cell("Admission", "No admission encounter linked to this account", full=true) }}</tr>
        {% endif %}

        {# ---- Patient identifiers, two per row ---- #}
        {% for pair in identifiers | batch(2) %}
        <tr>
            {% for ident in pair %}{% set cfg = ident.config %}{{ cell(cfg.display, ident.value) }}{% endfor %}
            {% if pair | length == 1 %}<td></td>{% endif %}
        </tr>
        {% endfor %}

        <tr>{{ cell("Tags", tags | join(", "), full=true) }}</tr>
        <tr>{{ cell("Patient Name", patient.name, full=true) }}</tr>

        {% if attender %}
        <tr>{{ cell("Attender", [attender.get('attender_relation'), attender.get('attender_name')] | select | join(" "), full=true) }}</tr>
        {% if attender.get('attender_phone') or attender.get('attender_address') %}
        <tr>
            {{ cell("Attender Phone", attender.get('attender_phone')) }}
            {{ cell("Attender Address", attender.get('attender_address')) }}
        </tr>
        {% endif %}
        {% endif %}

        <tr>
            {{ cell("Age / DOB", [patient.age, patient.date_of_birth | date] | select | join(" / ")) }}
            {{ cell("Gender", patient.gender) }}
        </tr>
        <tr>{{ cell("Address", patient.address, full=true) }}</tr>

        {# ---- Location with extension fallback ---- #}
        {% if has_enc %}
        {% set ext_location = (enc.extensions.get('encounter_kind_location_assignment') or {}).get('location') %}
        <tr>{{ cell("Location", enc.current_location.name or ext_location or "Yet to be assigned", full=true) }}</tr>
        {% endif %}

        {# ---- Specific charge item with paid badge ---- #}
        <tr>
            <td colspan="2">
                <span class="form-label">{{ charge_item_title }} :</span>
                <span class="form-value">
                    {% for item in account.charge_items.filter(title=charge_item_title, limit=1) %}
                    {{ item.total_price | currency if item.total_price else "-" }}
                    {% if item.paid_on %}<span class="badge-paid">PAID</span>{% endif %}
                    {% else %}-{% endfor %}
                </span>
            </td>
        </tr>
    </table>

    <div class="prepared-by">
        Created on : <strong>{{ current_datetime() }}</strong> &nbsp;|&nbsp;
        Generated By : <strong>{{ current_user.full_name or "-" }}</strong>
    </div>

    <div class="note-text">Note: This is a computer-generated {{ report_title }}. Please bring this slip for all hospital visits during this admission.</div>
    <div class="footer">This is a computer-generated {{ report_title }}.</div>
</body>
</html>
